# ─────────────────────────────────────────────────────────────
#  HVAC Cost Estimator — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── AI: Groq (FREE — no credit card required) ─────────────────
# Sign up at https://console.groq.com
# Click "API Keys" → "Create API Key" → paste it below
GROQ_API_KEY=your_groq_api_key_here

# ── Email (optional — only needed for RFQ / proposal emails) ──
# For Gmail: enable 2FA → Google Account → Security → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM_NAME=HVAC Estimating

# ── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ───────────────────────────
# Replace with your Neon / Railway / Supabase connection string
# Get from: https://neon.tech  or  https://railway.app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hvac_estimator?schema=public&sslmode=require"

# ── JWT Auth ───────────────────────────────────────────────────
# Generate BOTH secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT values for access and refresh — never reuse the same secret.
# Minimum 32 characters. 64 hex chars (256-bit) is recommended.
JWT_ACCESS_SECRET=replace-with-64-hex-chars-output-from-command-above
JWT_REFRESH_SECRET=replace-with-different-64-hex-chars-output
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Development:   http://localhost:5173
# Production:    https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173


# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Development:   http://localhost:5173
# Production:    https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173
